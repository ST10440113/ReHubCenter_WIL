@{
    ViewData["Title"] = "About Re-Center Hub";
}

<style>
    body {
        margin: 0;
        font-family: Arial, sans-serif;
    }

    .about-wrapper {
        display: flex;
        min-height: 100vh;
    }

    .about-left {
        background-color: #fff;
        width: 35%;
        min-width: 280px;
        padding: 40px;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
    }

        .about-left img {
            width: 100%;
            max-width: 300px;
            height: auto;
            object-fit: cover;
        }

    .about-right {
        background-color: #3f4632;
        width: 65%;
        padding: 50px 60px;
        color: #fff;
    }

        .about-right h1 {
            font-size: 2.5rem;
            font-weight: 800;
            margin: 0 0 20px 0;
        }

        .about-right h2 {
            font-size: 1.1rem;
            font-weight: bold;
            margin: 0 0 15px 0;
        }

        .about-right p {
            font-size: 1rem;
            line-height: 1.6;
            margin: 0 0 15px 0;
        }

        .about-right ul {
            margin: 0 0 15px 0;
            padding-left: 20px;
        }

        .about-right li {
            font-size: 1rem;
            line-height: 1.8;
        }
</style>

<div class="about-wrapper">

    <div class="about-left">
        <img src="~/image/Screenshot 2026-08-16 134144.png" height="450" width="450"/>
    </div>

    <div class="about-right">
        <h1>About Re-Center Hub</h1>

        <h2>Welcome to Re-Center Hub</h2>

        <p>A space dedicated to rebuilding minds, re-centering lives, and empowering growth.</p>

        <p>At Re-Center Hub, we are passionate about:</p>

        <ul>
            <li>Counselling &amp; Wellness</li>
            <li>Life Skills &amp; Education</li>
            <li>Youth Development &amp; Mentorship</li>
        </ul>

        <p>We believe that every young person deserves support, guidance, healing, and the opportunity to discover their purpose.</p>

        <p>This is more than a service — it is a journey toward transformation, hope, and meaningful change.</p>

        <p><strong>"A Hub for Growth. A Path to Purpose."</strong></p>

        <h2> Our Mission </h2>
        <p>To empower children, young people, families and schools through meaningful support , practical interventions and holistic development opportunties</p>

        <h2> <strong>Why choose us?</strong></h2>
        <p>- qualified child and youth care practitioner</p>
        <p>- school counselling experience</p>
        <p>- research informed practice</p>
        <p>- intervention facilitation</p>
        <p>- tailor made programmes</p>
        <p>- registered with SACSSP</p>
    </div>

</div>