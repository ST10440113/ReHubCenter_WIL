@model ReHubCenter_WIL.Models.IndividualBooking

@{
    ViewData["Title"] = "Create";

}
<style>
    body {background-color: #454b3a;}
</style>

<h1 class="heading_style">Individual Session Booking</h1>

<div style="display:flex; align-items:center; justify-content:center; margin-left:240px">
<div class="row">
    <div class="col-md-4" >
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="column">
                    <div class="form-group center_lable">
                 <label asp-for="FirstName" class="control-label text_colour"></label>
                    <input asp-for="FirstName" class="form-control" style="width:310px;height:45px; border-radius:20px" />
                <span asp-validation-for="FirstName" class="text-danger"></span>
            </div>
            <br />

                    <div class="form-group center_lable">
                        
                    <label asp-for="PhoneNumber" class="control-label text_colour"></label>
                        <input asp-for="PhoneNumber" class="form-control" style="width:310px;height:45px; border-radius:20px" />
                <span asp-validation-for="PhoneNumber" class="text-danger"></span>
            </div>
             <br />
            </div>
            <div class="column">
                    <div class="form-group center_lable">
                    <label asp-for="Surname" class="control-label text_colour"></label>
                        <input asp-for="Surname" class="form-control" style="width:310px;height:45px; border-radius:20px" />
                <span asp-validation-for="Surname" class="text-danger"></span>
            </div>
                    <br />
                    <div class="form-group center_lable">
                    <label asp-for="EmailAddress" class="control-label text_colour"></label>
                        <input asp-for="EmailAddress" class="form-control" style="width:310px;height:45px; border-radius:20px" />
                <span asp-validation-for="EmailAddress" class="text-danger"></span>
            </div>
                </div>
                    <div class="column">
                    <div class="form-group center_lable">
                    <label asp-for="Category" class="control-label text_colour"></label>
                        <select asp-for="Category" class="form-control" style="width:310px;height:45px; border-radius:20px">
                    <option value="">  Trauma & Abuse  </option>
                    <option value="">  Self-development  </option>
                    <option value="">  Addiction  </option>
                    <option value="">  Relationships  </option>
                    </select>
                <span asp-validation-for="Category" class="text-danger"></span>
            </div>
                    <br />

                    <div class="form-group center_lable">
                    <label asp-for="Date_and_Time" class="control-label text_colour"></label>
                        <input asp-for="Date_and_Time" class="form-control" style="width:310px;height:45px; border-radius:20px" />
                <span asp-validation-for="Date_and_Time" class="text-danger"></span>
            </div>
                    <br />
            </div>
                
               
                <div class="form-group center_lable" style="white-space:nowrap;margin-left: 470px">
                    <label class="control-label text_colour" style="margin-bottom:10px">Optional Notes</label>
                    <input asp-for="OptionalNotes" class="form-control" style="width:780px;height:55px;border-radius:20px" />
                    <span asp-validation-for="OptionalNotes" class="text-danger"></span>
                </div>
                </form>
                <br />
                <br />

                <div class="submit-button" style="margin-left: 410px;">
                    <input type="submit" value="Submit" class="btn btn-primary" />
                </div>

            <div style="margin-left: 445px; margin-top:15px;">
            <a asp-action="Index" class="btn btn-secondary">Back</a>
            </div>
        </div>
    </div>
</div>

